/* Build Manager Kit — editor window theme.
   Colours are expressed as translucent overlays on top of Unity's own window colours so the
   window reads correctly in both the dark and the light editor theme. */

:root {
    --bmk-accent: rgb(88, 166, 255);
    --bmk-success: rgb(63, 185, 80);
    --bmk-warning: rgb(210, 153, 34);
    --bmk-error: rgb(248, 81, 73);
    --bmk-muted: rgba(128, 128, 128, 0.85);
    --bmk-surface: rgba(128, 128, 128, 0.09);
    --bmk-surface-strong: rgba(128, 128, 128, 0.16);
    --bmk-border: rgba(128, 128, 128, 0.32);
    --bmk-radius: 6px;
}

.bmk-root {
    flex-grow: 1;
    flex-direction: column;
    /* Without this the body can push the header and status bar out of the window. */
    min-height: 0;
}

/* ---------------------------------------------------------------- header */

/* The header and the status bar are fixed furniture: they must never shrink or
   scroll away, however tall the content between them gets. */
.bmk-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    flex-wrap: wrap;
    padding: 6px 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--bmk-border);
    background-color: var(--bmk-surface);
}

.bmk-header > * {
    flex-shrink: 0;
}

.bmk-header__title {
    -unity-font-style: bold;
    font-size: 13px;
    margin-right: 4px;
    flex-shrink: 0;
}

.bmk-header__version {
    color: var(--bmk-muted);
    font-size: 10px;
    margin-right: 12px;
    margin-top: 2px;
    flex-shrink: 0;
}

/* Controls keep their natural width; only the flexible spacer absorbs slack. */
.bmk-header__controls {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    flex-wrap: wrap;
}

.bmk-header__controls > Button {
    flex-shrink: 0;
    margin-left: 2px;
}

.bmk-header__spacer {
    flex-grow: 1;
}

.bmk-pill {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 22px;
    min-height: 22px;
    max-width: 220px;
    padding: 0 10px;
    margin-right: 6px;
    border-radius: 11px;
    border-width: 1px;
    border-color: var(--bmk-border);
    background-color: var(--bmk-surface-strong);
}

.bmk-pill:hover {
    border-color: var(--bmk-accent);
}

.bmk-pill__dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 4px;
    margin-right: 6px;
    background-color: var(--bmk-muted);
}

.bmk-pill__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-right: 6px;
}

/* Separates the "what am I looking at" pills from the "what will I build" pills. */
.bmk-divider {
    width: 1px;
    height: 16px;
    flex-shrink: 0;
    margin: 0 6px 0 2px;
    background-color: var(--bmk-border);
}

.bmk-pill__label {
    font-size: 11px;
    -unity-font-style: bold;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.bmk-pill__caret {
    margin-left: 6px;
    font-size: 9px;
    color: var(--bmk-muted);
    flex-shrink: 0;
}

/* ---------------------------------------------------------------- layout */

/* min-height:0 lets the body actually shrink to the space left over by the
   header and status bar, which is what keeps tall pages inside the window. */
.bmk-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

.bmk-sidebar {
    width: 168px;
    min-width: 168px;
    flex-shrink: 0;
    padding: 8px 6px;
    border-right-width: 1px;
    border-right-color: var(--bmk-border);
    background-color: var(--bmk-surface);
    overflow: hidden;
}

.bmk-nav {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 28px;
    min-height: 28px;
    padding: 0 10px;
    margin-bottom: 2px;
    border-radius: var(--bmk-radius);
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.bmk-nav:hover {
    background-color: var(--bmk-surface-strong);
}

.bmk-nav--selected {
    background-color: var(--bmk-surface-strong);
    border-left-color: var(--bmk-accent);
}

.bmk-nav__label {
    font-size: 12px;
}

.bmk-nav--selected .bmk-nav__label {
    -unity-font-style: bold;
}

.bmk-nav__badge {
    margin-left: auto;
    font-size: 10px;
    color: var(--bmk-muted);
}

.bmk-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    padding: 12px 14px;
    overflow: hidden;
}

.bmk-scroll {
    flex-grow: 1;
    min-height: 0;
}

/* The two-pane pages (Profiles, Environments, History) put a fixed master list
   next to a scrolling detail pane. Both need min-height:0 so the page scrolls
   instead of stretching the window furniture. */
.bmk-split {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    align-items: stretch;
    min-height: 0;
}

/* ---------------------------------------------------------------- cards */

.bmk-card {
    padding: 10px 12px;
    margin-bottom: 10px;
    border-radius: var(--bmk-radius);
    border-width: 1px;
    border-color: var(--bmk-border);
    background-color: var(--bmk-surface);
    flex-shrink: 0;
    min-width: 0;
}

.bmk-card--accent {
    border-left-width: 4px;
}

.bmk-card__title {
    -unity-font-style: bold;
    font-size: 12px;
    margin-bottom: 6px;
}

.bmk-card__subtitle {
    color: var(--bmk-muted);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 6px;
}

.bmk-section-title {
    -unity-font-style: bold;
    font-size: 11px;
    color: var(--bmk-muted);
    margin: 10px 0 4px 2px;
}

.bmk-row {
    flex-direction: row;
    align-items: center;
}

.bmk-row--wrap {
    flex-wrap: wrap;
}

.bmk-grow {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* A wrapping text block that shares a row with a fixed-size control. The explicit
   flex-basis is what lets it wrap its text instead of forcing the row wider than
   the pane and pushing its sibling off the edge. */
.bmk-flex-text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 60%;
    min-width: 180px;
    margin-right: 8px;
    margin-bottom: 4px;
    white-space: normal;
    color: var(--bmk-muted);
    font-size: 11px;
}

.bmk-muted {
    color: var(--bmk-muted);
    font-size: 11px;
    white-space: normal;
}

.bmk-mono {
    font-size: 11px;
    white-space: normal;
}

/* ---------------------------------------------------------------- buttons */

.bmk-button-primary {
    height: 24px;
    min-width: 84px;
    padding: 0 14px;
    border-radius: var(--bmk-radius);
    border-width: 0;
    background-color: var(--bmk-accent);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.bmk-button-primary:hover {
    background-color: rgb(110, 180, 255);
}

.bmk-button-primary:disabled {
    opacity: 0.45;
}

.bmk-button-danger {
    background-color: rgba(248, 81, 73, 0.18);
    border-color: var(--bmk-error);
}

/* Square icon buttons ("⋮", "⋯", "×"): wide enough for the glyph plus the
   button's own padding, and never allowed to shrink below that. */
.bmk-icon-button {
    width: 26px;
    min-width: 26px;
    max-width: 26px;
    height: 20px;
    min-height: 20px;
    flex-shrink: 0;
    padding: 0;
    margin: 0 0 0 4px;
    -unity-text-align: middle-center;
}

.bmk-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.bmk-toolbar > Button {
    margin-right: 4px;
}

/* ---------------------------------------------------------------- status */

.bmk-status {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 24px;
    min-height: 24px;
    padding: 0 8px;
    border-top-width: 1px;
    border-top-color: var(--bmk-border);
    background-color: var(--bmk-surface);
    overflow: hidden;
}

/* The message is the only elastic part: it ellipsises rather than squeezing the
   buttons next to it into unreadable slivers. */
.bmk-status__label {
    font-size: 11px;
    color: var(--bmk-muted);
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.bmk-status > Button {
    flex-shrink: 0;
    height: 18px;
    min-height: 18px;
    margin: 0 0 0 4px;
    padding: 0 8px;
    font-size: 10px;
}

.bmk-badge {
    padding: 1px 7px;
    margin-right: 6px;
    border-radius: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.bmk-badge--success { background-color: var(--bmk-success); }
.bmk-badge--error   { background-color: var(--bmk-error); }
.bmk-badge--warning { background-color: var(--bmk-warning); }
.bmk-badge--neutral { background-color: var(--bmk-muted); }

/* ---------------------------------------------------------------- console */

.bmk-console {
    flex-grow: 1;
    min-height: 140px;
    border-radius: var(--bmk-radius);
    border-width: 1px;
    border-color: var(--bmk-border);
    background-color: rgba(0, 0, 0, 0.18);
}

.bmk-console__line {
    padding: 1px 8px;
    font-size: 11px;
    white-space: normal;
}

.bmk-console__line--debug   { color: rgba(150, 150, 150, 0.9); }
.bmk-console__line--info    { color: rgba(210, 210, 210, 0.95); }
.bmk-console__line--success { color: var(--bmk-success); }
.bmk-console__line--warning { color: var(--bmk-warning); }
.bmk-console__line--error   { color: var(--bmk-error); }

/* ---------------------------------------------------------------- lists */

.bmk-list {
    border-radius: var(--bmk-radius);
    border-width: 1px;
    border-color: var(--bmk-border);
}

.bmk-list-item {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.14);
}

.bmk-list-item:hover {
    background-color: var(--bmk-surface-strong);
}

.bmk-list-item--selected {
    background-color: rgba(88, 166, 255, 0.18);
}

/* ---------------------------------------------------------------- reorder */

/* The grip. Kept dim until the row is hovered so a list at rest stays calm. */
.bmk-drag-handle {
    width: 14px;
    min-width: 14px;
    flex-shrink: 0;
    margin-right: 4px;
    font-size: 11px;
    color: rgba(128, 128, 128, 0.55);
    -unity-text-align: middle-center;
    cursor: pan;
}

.bmk-drag-handle:hover {
    color: var(--bmk-accent);
}

.bmk-list-item:hover .bmk-drag-handle,
.bmk-step:hover .bmk-drag-handle {
    color: rgba(160, 160, 160, 0.9);
}

/* The travelling row. It reads as lifted off the list rather than faded out: opaque so it
   covers whatever it passes over, with an accent outline marking it as the thing in hand. */
.bmk-row--dragging {
    opacity: 0.97;
    background-color: var(--bmk-surface-strong);
    border-width: 1px;
    border-color: var(--bmk-accent);
    border-radius: var(--bmk-radius);
}

.bmk-row--dragging .bmk-drag-handle {
    color: var(--bmk-accent);
}

/* The greyed slot the row will land in. Absolutely positioned inside the host so moving it
   never reflows anything; the gap it sits in is opened by translating the rows instead. */
/* An empty slot. The dashed outline is stroked in DashedBox because USS has no
   border-style, and there is no fill so the gap reads as a hole in the list. */
.bmk-drop-placeholder {
    position: absolute;
    left: 0;
    right: 0;
    transition-property: top;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}

/* Applied to the rows that are not being dragged, so they glide aside instead of snapping. */
.bmk-row--gliding {
    transition-property: translate;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}

.bmk-reorder-host {
    position: relative;
}

.bmk-master {
    width: 220px;
    min-width: 180px;
    flex-shrink: 0;
    margin-right: 10px;
    min-height: 0;
}

.bmk-detail {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

/* ---------------------------------------------------------------- steps */

.bmk-step {
    margin-bottom: 6px;
    border-radius: var(--bmk-radius);
    border-width: 1px;
    border-color: var(--bmk-border);
    background-color: var(--bmk-surface);
}

.bmk-step--disabled {
    opacity: 0.5;
}

.bmk-step__header {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 6px;
}

.bmk-step__title {
    -unity-font-style: bold;
    font-size: 11px;
    margin-right: 8px;
}

.bmk-step__key {
    flex-shrink: 0;
    margin-right: 8px;
    padding: 0 6px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--bmk-accent);
    color: var(--bmk-accent);
    font-size: 9px;
}

.bmk-step__summary {
    flex-grow: 1;
    color: var(--bmk-muted);
    font-size: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.bmk-step__body {
    padding: 4px 10px 8px 10px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.14);
}

.bmk-step__index {
    width: 20px;
    color: var(--bmk-muted);
    font-size: 10px;
    -unity-text-align: middle-center;
}

.bmk-empty {
    padding: 14px;
    -unity-text-align: middle-center;
    color: var(--bmk-muted);
    font-size: 11px;
    white-space: normal;
}

/* ---------------------------------------------------------------- misc */

.bmk-code {
    padding: 8px;
    border-radius: var(--bmk-radius);
    border-width: 1px;
    border-color: var(--bmk-border);
    background-color: rgba(0, 0, 0, 0.18);
    font-size: 11px;
    white-space: normal;
}

.bmk-kv {
    flex-direction: row;
    margin-bottom: 2px;
}

.bmk-kv__key {
    width: 132px;
    color: var(--bmk-muted);
    font-size: 11px;
}

.bmk-kv__value {
    flex-grow: 1;
    font-size: 11px;
    white-space: normal;
}

/* ---- Application icon override ------------------------------------------------ */

.bmk-icon-row {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 8px;
}

/* Checkerboard is not available in USS, so a flat well plus a border is what reads
   best behind an icon that may itself have transparency. */
.bmk-icon-frame {
    width: 76px;
    height: 76px;
    border-radius: var(--bmk-radius);
    border-width: 1px;
    border-color: var(--bmk-border);
    background-color: var(--bmk-surface-strong);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
}

.bmk-icon-frame--empty {
    border-color: var(--bmk-border);
}

.bmk-icon-image {
    width: 64px;
    height: 64px;
}

.bmk-icon-empty-label {
    font-size: 10px;
    color: var(--bmk-muted);
    -unity-text-align: middle-center;
    white-space: normal;
}

.bmk-icon-fields {
    flex-grow: 1;
    margin-left: 10px;
    min-width: 0;
}

/* ---- Build button with a target menu ------------------------------------------ */

/* One control, two hit areas: the wide half builds what is selected, the caret half
   opens the target list. Keeping them in a single rounded shell is what makes it read
   as "Build, or…" rather than as two unrelated buttons. */
.bmk-build-button {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 4px;
}

.bmk-build-button__main {
    margin: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

.bmk-build-button__caret {
    height: 24px;
    min-height: 24px;
    width: 22px;
    min-width: 22px;
    max-width: 22px;
    padding: 0;
    margin: 0 0 0 1px;
    border-width: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: var(--bmk-radius);
    border-bottom-right-radius: var(--bmk-radius);
    background-color: var(--bmk-accent);
    color: rgb(255, 255, 255);
    font-size: 9px;
    -unity-text-align: middle-center;
}

.bmk-build-button__caret:hover {
    background-color: rgb(110, 180, 255);
}

.bmk-build-button__caret:disabled {
    opacity: 0.45;
}

/* ---- Versioning ---------------------------------------------------------------- */

/* The detail rows sit under their switch, so the indent is what shows they belong to
   it — and an empty indent is invisible rather than leaving a gap. */
.bmk-versioning__details {
    margin-left: 14px;
    margin-bottom: 2px;
}

.bmk-versioning Label.bmk-muted {
    margin-top: 6px;
}

/* ---- Inherited values ---------------------------------------------------------- */

.bmk-inherited {
    flex-direction: row;
    align-items: center;
    margin: 1px 0 3px 14px;
}

.bmk-inherited__label {
    font-size: 10px;
    color: var(--bmk-muted);
    white-space: normal;
    flex-shrink: 1;
    margin: 1px 0 6px 3px;
}

/* ---- The pinned common configuration row --------------------------------------- */

/* Sits above the environment list in its own section: selectable like a row, but with
   no grip, because there is nothing to reorder it against. */
.bmk-common-row {
    flex-shrink: 0;
    margin-bottom: 2px;
    padding-left: 8px;
}

/* ---- Inherited values ---------------------------------------------------------- */

.bmk-inherited {
    flex-direction: row;
    align-items: center;
    margin: 1px 0 3px 14px;
}

.bmk-inherited__label {
    font-size: 10px;
    color: var(--bmk-muted);
    white-space: normal;
    flex-shrink: 1;
    margin: 1px 0 6px 3px;
}

/* Build Manager Kit — the rules EditorCoreKit does not cover.

   Everything structural and every colour comes from the kit's stylesheets, which are attached
   first by BuildManagerUI.ApplyStyles. What is left here is the handful of controls that only a
   build tool has.

   Colours are written as var(--kui-…) rather than as literals, for the same reason the kit does
   it: that is what lets these controls pick up a theme they have never heard of. Never introduce
   a literal colour in this file — a `rgb(...)` here is a control that stays blue in the ember
   theme and stays dark under the parchment one. */

/* ---- Build button with a target menu ------------------------------------------ */

/* One control, two hit areas: the wide half builds what is selected, the caret half
   opens the target list. Keeping them in a single rounded shell is what makes it read
   as "Build, or…" rather than as two unrelated buttons. */
.bmk-build-button {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 4px;
}

.bmk-build-button__main {
    margin: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

.bmk-build-button__caret {
    height: 24px;
    min-height: 24px;
    width: 22px;
    min-width: 22px;
    max-width: 22px;
    padding: 0;
    margin: 0 0 0 1px;
    border-width: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: var(--kui-radius);
    border-bottom-right-radius: var(--kui-radius);
    background-color: var(--kui-accent);
    color: var(--kui-on-accent);
    font-size: 9px;
    -unity-text-align: middle-center;
}

.bmk-build-button__caret:hover {
    background-color: var(--kui-accent-strong);
}

.bmk-build-button__caret:disabled {
    opacity: 0.45;
}

/* ---- Versioning ---------------------------------------------------------------- */

/* The detail rows sit under their switch, so the indent is what shows they belong to
   it — and an empty indent is invisible rather than leaving a gap. */
.bmk-versioning__details {
    margin-left: 14px;
    margin-bottom: 2px;
}

.bmk-versioning Label.kui-muted {
    margin-top: 6px;
}

/* ---- Inherited values ---------------------------------------------------------- */

/* Says where a value that is not set here comes from. Smaller and tighter than a plain
   muted line, because it belongs to the field directly above it. */
.bmk-inherited__label {
    font-size: 10px;
    white-space: normal;
    flex-shrink: 1;
    margin: 1px 0 6px 3px;
}

/* ---- The pinned common configuration row --------------------------------------- */

/* Sits above the environment list in its own section: selectable like a row, but with
   no grip, because there is nothing to reorder it against. */
.bmk-common-row {
    flex-shrink: 0;
    margin-bottom: 2px;
    border-radius: var(--kui-radius);
    border-width: 1px;
    border-color: var(--kui-border);
}
